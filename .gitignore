# Python / Django 项目相关
# Python 解释器生成的字节码缓存目录，自动生成无需提交
__pycache__/
# .pyc / .pyo / .pyd 字节码文件，编译产物
*.py[cod]
# Jython 生成的类文件
*$py.class
# Python 虚拟环境目录
venv/
env/
# 环境变量配置文件（含密钥、密码，严禁提交）
.env
# Django 默认 SQLite 数据库文件
db.sqlite3
# Django 媒体文件：用户上传的病害图片
media/
backend/media/
backend/db.sqlite3

# Node / Vue 前端项目相关
# Node.js 依赖包
node_modules/
# 前端打包构建产物
dist/
# Vite 缓存目录
.vite/
# macOS 系统文件
.DS_Store

# YOLO / AI 模型训练相关
# YOLO 训练输出：日志、验证结果、中间权重文件
runs/
# PyTorch 模型权重文件
*.pt
# 病害数据集
datasets/plant_disease/images/
datasets/plant_disease/labels/
datasets/plantdoc_raw/

# IDE 编辑器配置
.vscode/
.idea/

# 操作系统临时文件
Thumbs.db
*.swp
*.swo